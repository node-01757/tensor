{
  "name": "tensor",
  "private": true,
  "type": "module",
  "description": "TENSOR — prototipo narrativo. Nessuna dipendenza: questi script servono solo in sviluppo.",
  "scripts": {
    "build:dna": "node tools/build-dna.mjs",
    "validate": "node tools/build-dna.mjs --check && node tools/validate.mjs",
    "validate:strict": "node tools/validate.mjs --strict",
    "test": "node --test tools/test-profiler.mjs tools/test-cross-pov.mjs",
    "serve": "python3 -m http.server 8000 --directory prototype"
  }
}
